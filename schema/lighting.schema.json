{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kewe87/casehud-library/main/schema/lighting.schema.json",
  "title": "CaseHUD library: lighting preset",
  "description": "One effect with its parameters. 'params' uses exactly the parameter keys of the LED engine effect (see docs/components.md#lighting-presets).",
  "type": "object",
  "required": ["format", "id", "name", "description", "effect", "params", "tags", "author", "license"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "format": {"const": 1},
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "name": {"$ref": "#/$defs/i18n"},
    "description": {"$ref": "#/$defs/i18n"},
    "effect": {"enum": ["rainbow", "solid", "breathing", "wave", "sensor", "cycle", "meteor", "fill", "burst", "shuttle", "bounce", "stack", "sparkle", "stripes", "sand", "spark", "meet", "rainbow-gaps"]},
    "params": {
      "type": "object", "maxProperties": 32,
      "additionalProperties": {"oneOf": [
        {"type": "number"}, {"type": "boolean"}, {"type": "string", "maxLength": 400}
      ]},
      "propertyNames": {"pattern": "^[a-zA-Z][a-zA-Z0-9]{0,31}$"}
    },
    "path": {
      "type": "object", "additionalProperties": false,
      "description": "Optional shortcut for the path parameters of motion effects; merged over 'params'.",
      "properties": {
        "mode": {"enum": ["around", "horizontal", "vertical", "radial"]},
        "mirror": {"type": "boolean"},
        "reverse": {"type": "boolean"}
      }
    },
    "palette": {
      "type": "array", "maxItems": 6,
      "items": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
      "description": "Preview swatches for the gallery. The effect itself uses the colors in 'params'."
    },
    "tags": {
      "type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 8,
      "items": {"enum": ["calm", "gaming", "water", "sensor", "party", "night", "clean", "neon", "retro", "cyberpunk"]}
    },
    "author": {"type": "string", "minLength": 1, "maxLength": 64},
    "license": {"const": "CC-BY-4.0"}
  },
  "$defs": {
    "i18n": {
      "type": "object", "required": ["de", "en"], "additionalProperties": false,
      "properties": {"de": {"type": "string", "minLength": 1, "maxLength": 200}, "en": {"type": "string", "minLength": 1, "maxLength": 200}}
    }
  }
}
